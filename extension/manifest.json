{
  "manifest_version": 3,
  "name": "HLS Stream Detector (Educativo)",
  "version": "5.5.1",
  "description": "Detecta videos en vivo (HLS, DASH), videos de las páginas y directos de YouTube; los analiza, los monitorea y los reúne en un solo link de lista M3U.",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "storage",
    "notifications",
    "contextMenus",
    "offscreen",
    "alarms",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flujos HLS detectados",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Abrir la lista de flujos"
    },
    "copy-main": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copiar link del flujo principal"
    },
    "monitor-main": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Abrir monitor en vivo del flujo principal"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}